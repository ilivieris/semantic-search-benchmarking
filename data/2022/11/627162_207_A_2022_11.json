                    },
                    {
                        "header": "Άρθρο έκτο",
                        "title": null,
                        "id": "έκτο",
                        "type": "article",
                        "text": "Ανταλλαγή πληροφοριών και εγγράφων.",
                        "sub_articles": null,
                        "paragraphs": null,
                        "is_valid": true
                    },
                    {
                        "header": "Άρθρο έβδομο",
                        "title": null,
                        "id": "έβδομο",
                        "type": "article",
                        "text": "Επίλυση διαφορών από την ερμηνεία και εφαρμογή του Μνημονίου Κατανόησης.",
